    "audio.hardwareGain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not expose an input level control. Adjust its physical gain knob or control panel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрій не надає керування рівнем входу. Використовуй його ручку gain або панель керування."
          }
        }
      }
    },
    "audio.routeGuidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For electric guitar, use a clean instrument input and wired headphones on the same USB interface. Other routes need timing validation before rhythm grading."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для електрогітари використовуй чистий інструментальний вхід і дротові навушники на тому самому USB-інтерфейсі. Інші маршрути потребують перевірки затримки перед оцінюванням ритму."
          }
        }
      }
    },
    "audio.monitoringOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software monitoring is off. No input audio is sent to the output or saved to disk."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програмний моніторинг вимкнено. Звук входу не надсилається на вихід і не зберігається на диск."
          }
        }
      }
    },

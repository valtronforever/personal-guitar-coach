            "state": "translated",
            "value": "Uncertainty allowance (ms)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допуск невизначеності (мс)"
          }
        }
      }
    },
    "calibration.pulses": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched pulses"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зіставлені імпульси"
          }
        }
      }
    },
    "calibration.duration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured duration (seconds)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тривалість вимірювання (секунди)"
          }
        }
      }
    },
    "calibration.measuredGate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rhythm eligibility is checked for each attempt: calibration uncertainty, onset detection and clock drift together must fit within half the timing tolerance."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступність оцінки ритму перевіряємо для кожної спроби: сума невизначеності калібрування, детектора атак і дрейфу годинників має вкладатися в половину ритмічного допуску."
          }
        }
      }
    },
    "calibration.pitchOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitch practice is available. Rhythm and overall scores remain unavailable until timing is verified."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Практика висоти доступна. Оцінки ритму та загальна оцінка недоступні до перевірки часу."
          }
        }
      }
    },
    "calibration.forget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget this profile"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цей профіль"
          }
        }
      }
    },
    "calibration.loopback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure with a cable"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виміряти через кабель"
          }
        }
      }
    },
    "calibration.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a line output to a compatible line input using the appropriate cable. Disconnect the guitar, turn direct monitoring off and start with low output and input gain. The app sends quiet pulses; it does not monitor the input to the output. Avoid clipping. Reconnect the guitar after measurement."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднайте лінійний вихід із сумісним лінійним входом відповідним кабелем. Від’єднайте гітару, вимкніть direct monitoring і почніть із малої гучності виходу та підсилення входу. Додаток надсилає тихі імпульси й не передає вхід на вихід. Уникайте перевантаження. Після вимірювання під’єднайте гітару знову."
          }
        }
      }
    },
    "calibration.cableReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cable connected; direct monitoring off; levels low"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кабель під’єднано; direct monitoring вимкнено; рівні низькі"
          }
        }
      }
    },
    "calibration.longRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long measurement (about 15 minutes)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Довге вимірювання (приблизно 15 хвилин)"
          }
        }
      }
    },
    "calibration.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start loopback measurement"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почати вимірювання loopback"
          }
        }
      }
    },
    "calibration.measuring": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measuring…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимірюємо…"
          }
        }

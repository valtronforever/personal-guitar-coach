    "audio.introduction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your guitar input and one channel. Start the input check to inspect the signal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери вхід гітари та один канал. Запусти перевірку входу, щоб побачити сигнал."
          }
        }
      }
    },

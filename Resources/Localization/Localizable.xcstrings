    "playback.seekExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a position while stopped or paused, then play with a new count-in. Later loops use the full bar range."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери позицію під час зупинки або паузи, потім почни з нового відліку. Наступні повтори охоплюють увесь вибраний діапазон тактів."
          }
        }
      }
    },
    "playback.optionsExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause or stop to change these options. They apply to the next playback segment. Set example volume to zero to hear only the metronome."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупини або зупини відтворення, щоб змінити параметри. Вони діятимуть із наступного запуску. Гучність прикладу 0 залишає лише метроном."
          }
        }
      }
    },
    "playback.audioInUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the other audio activity before playing an example."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупини інший аудіорежим перед прослуховуванням прикладу."
          }
        }
      }
    },
    "playback.chooseOutput": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an output and channel in Audio setup to listen. No microphone permission is needed."

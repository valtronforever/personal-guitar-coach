    "audio.clickExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test click: 120 BPM at low volume. No software monitoring or audio recording."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестовий метроном: 120 BPM на невеликій гучності. Без програмного моніторингу та запису аудіо."
          }
        }
      }
    },
    "audio.error.system": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio device could not start. Check its connection and configuration."

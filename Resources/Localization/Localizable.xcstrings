    "tuning.editorExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter note names with octaves, such as E2, F#3, or B♭3. A4 accepts 400–480 Hz. Saving a custom copy leaves the preset unchanged."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введи ноти з октавами, наприклад E2, F#3 або B♭3. A4 допускає 400–480 Гц. Збереження власної копії не змінює пресет."
          }
        }
      }
    },

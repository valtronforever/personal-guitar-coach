    "lesson.position.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the same notes and octaves in an area of up to five frets. The first note may be above the selected fret. Only positions that fit the complete lesson are offered."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережи ті самі ноти й октави в межах до п’яти ладів. Перша нота може бути вище вибраного ладу. Доступні лише позиції, у яких вміщується весь урок."
          }
        }
      }
    },
    "lesson.position.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved position cannot fit this lesson with the selected instrument settings. Choose another position or the original fingering in the lesson."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережена позиція не вміщує цей урок із вибраними налаштуваннями інструмента. Вибери іншу позицію або початкову аплікатуру в уроці."
          }
        }
      }
    },
    "lesson.position.change": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change position in lesson"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінити позицію в уроці"
          }
        }
      }
    },
    "lesson.activity.fixedPosition": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assigned position"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призначена позиція"
          }
        }
      }
    },
    "lesson.activity.window %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Region width: up to %lld frets"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина ділянки: до %lld ладів"
          }
        }
      }
    },
    "lesson.activity.stepUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This example is unavailable for the selected instrument and position. Select this step to review its position choices."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей приклад недоступний для вибраного інструменту й позиції. Оберіть крок, щоб переглянути варіанти позицій."
          }
        }
      }
    },
    "lesson.activity.selfConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I used the displayed fingering"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я використав(-ла) показану аплікатуру"
          }
        }
      }
    },
    "lesson.activity.selfConfirmHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own report, separate from the pitch and timing assessment. Audio cannot identify the string, fret or finger used."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше повідомлення, окреме від оцінки висоти й ритму. Звук не визначає використану струну, лад чи палець."
          }
        }
      }
    },
    "lesson.activity.selfReported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingering use: self-reported by the player"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використання аплікатури: підтверджено самим виконавцем"
          }
        }
      }
    },
    "lesson.activity.error.invalidPolicy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This activity has invalid position rules."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дія містить некоректні правила позицій."
          }
        }
      }
    },
    "lesson.activity.error.forbiddenChoice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The author does not allow this position. Choose an available option."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автор не дозволяє цю позицію. Оберіть доступний варіант."
          }
        }
      }
    },
    "lesson.activity.error.beyondFretCount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This position exceeds the fret count selected in Settings."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця позиція виходить за кількість ладів, вибрану в налаштуваннях."
          }
        }
      }
    },
    "lesson.activity.error.regionUnplayable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The complete material cannot fit this region with the current tuning while keeping every note and octave. Choose another region or step."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь матеріал не вміщується в цій ділянці з поточним строєм зі збереженням усіх нот та октав. Оберіть іншу ділянку або крок."
          }
        }
      }
    },
    "lesson.activity.error.incompatibleTuning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This material uses incompatible tuning contexts."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей матеріал використовує несумісні строї."
          }
        }
      }
    },
    "staff.fragment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragment: the final bar ends with the selected material."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фрагмент: останній такт закінчується разом із вибраним матеріалом."
          }
        }
      }
    },
    "lesson.activity.stepNumber %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Крок %lld"
          }
        }
      }
    },
    "calibration.method.personal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal synchronization · approximate timing"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Персональна синхронізація · приблизний таймінг"
          }
        }
      }
    },
    "sync.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play one open string to the metronome to set your personal timing compensation. This includes audio latency and your own timing tendency; it does not measure hardware latency separately."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зіграйте одну відкриту струну під метроном, щоб визначити персональну компенсацію таймінгу. Вона включає затримку аудіо та вашу звичку грати раніше чи пізніше; окрему затримку обладнання так виміряти неможливо."
          }
        }
      }
    },
    "sync.bluetooth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can use a guitar interface for input and Bluetooth headphones for output. Keep the guitar input selected. Repeat synchronization after reconnecting, changing devices, or restarting the app. Variable Bluetooth delay cannot be removed with a constant offset."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна вибрати гітарний інтерфейс для входу, а Bluetooth-навушники — для виходу. Залиште гітарний вхід обраним. Повторюйте синхронізацію після перепідключення, зміни пристроїв або перезапуску додатка. Сталий зсув не усуває мінливу затримку Bluetooth."
          }
        }
      }
    },
    "sync.headphones": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use headphones so the microphone cannot mistake the click for a guitar attack. This setting does not remove audible delay when monitoring your guitar through Bluetooth."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користуйтеся навушниками, щоб мікрофон не приймав клік за атаку гітари. Це налаштування не усуває чутну затримку моніторингу гітари через Bluetooth."
          }
        }
      }
    },
    "sync.prepare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare your guitar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготуйте гітару"
          }
        }
      }
    },
    "sync.string": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open string"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрита струна"
          }
        }
      }
    },
    "sync.stringNote %lld %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "String %1$lld · %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Струна %1$lld · %2$@"
          }
        }
      }
    },
    "sync.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tune the selected string and mute the others. After Start, pluck and sustain it for the signal check. Listen to four clicks without playing, then play on each of the next sixteen clicks. Let each note ring for about half a second, then mute it before the next click. Follow the sound, not the progress bar. Repeat for the second pass."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте обрану струну й приглушіть інші. Після початку зіграйте її та дайте звучати для перевірки сигналу. Прослухайте чотири кліки без гри, потім грайте на кожен із наступних шістнадцяти кліків. Дайте кожній ноті звучати приблизно пів секунди, потім приглушіть перед наступним кліком. Орієнтуйтеся на звук, а не індикатор прогресу. Повторіть у другому проході."
          }
        }
      }
    },
    "sync.source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signal source from instrument settings:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Джерело сигналу з налаштувань інструменту:"
          }
        }
      }
    },
    "sync.pass %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass %lld of 2 · 60 BPM"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прохід %lld із 2 · 60 BPM"
          }
        }
      }
    },
    "sync.stage.signal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluck and sustain the selected open string. Waiting for a clean, in-tune signal…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зіграйте обрану відкриту струну й дайте їй звучати. Очікуємо чистий, налаштований сигнал…"
          }
        }
      }
    },
    "sync.stage.listening": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen to four clicks. Do not play yet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прослухайте чотири кліки. Поки не грайте."
          }
        }
      }
    },
    "sync.stage.playing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play one note on each click. Let it ring for about half a second, then mute it before the next click."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Грайте одну ноту на кожен клік. Дайте їй звучати приблизно пів секунди, потім приглушіть перед наступним кліком."
          }
        }
      }
    },
    "sync.progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass progress"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогрес проходу"
          }
        }
      }
    },
    "sync.between": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First pass accepted. Rest briefly, then repeat the same pattern to check consistency."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перший прохід прийнято. Трохи відпочиньте й повторіть той самий малюнок для перевірки стабільності."
          }
        }
      }
    },
    "sync.secondPass": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start second pass"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почати другий прохід"
          }
        }
      }
    },
    "sync.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start two-pass synchronization"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почати синхронізацію з двох проходів"
          }
        }
      }
    },
    "sync.audioInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the other audio activity before starting synchronization."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиніть іншу аудіоактивність перед початком синхронізації."
          }
        }
      }
    },
    "sync.result": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review your compensation"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте компенсацію"
          }
        }
      }
    },
    "sync.resultExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both passes agreed. Apply to use this fixed offset in subsequent practice. Positive means detected attacks arrived later than the clicks. Repeatability describes variation, not absolute hardware accuracy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидва проходи узгоджені. Застосуйте цей сталий зсув для наступних вправ. Додатне значення означає, що виявлені атаки надходили пізніше кліків. Повторюваність описує коливання, а не абсолютну точність обладнання."
          }
        }
      }
    },
    "sync.eligible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate rhythm scoring is available for sufficiently spaced notes while the audio clock remains stable. Try a familiar exercise after applying."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизна оцінка ритму доступна для достатньо розділених нот за стабільного аудіогодинника. Після застосування спробуйте знайому вправу."
          }
        }
      }
    },
    "sync.uncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This measurement is too variable for rhythm scoring. Retry with steadier timing or another output. Pitch practice remains available."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це вимірювання надто мінливе для оцінювання ритму. Повторіть із рівнішим таймінгом або іншим виходом. Практика висоти нот залишається доступною."
          }
        }
      }
    },
    "sync.apply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply compensation"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосувати компенсацію"
          }
        }
      }
    },
    "sync.repeatability": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeatability allowance (ms)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допуск повторюваності (мс)"
          }
        }
      }
    },
    "sync.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved profile needs a new two-pass check for this session and instrument before it can affect practice."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережений профіль потребує нової перевірки з двох проходів для цього сеансу й інструменту, перш ніж його буде застосовано у практиці."
          }
        }
      }
    },
    "sync.routeChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio or instrument settings changed. Start synchronization again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінилися налаштування аудіо або інструменту. Почніть синхронізацію знову."
          }
        }
      }
    },
    "sync.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization cancelled. No new compensation was applied."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізацію скасовано. Нову компенсацію не застосовано."
          }
        }
      }
    },
    "sync.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not obtain two consistent passes. Check the selected string and input level; avoid distortion and click leakage. Play all sixteen notes per pass. Timing must stay within 400 ms of each click. Retry or try a wired output if delay varies."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося отримати два узгоджені проходи. Перевірте обрану струну та рівень входу; уникайте дисторшну й потрапляння кліків у вхід. Зіграйте всі шістнадцять нот у кожному проході з відхиленням до 400 мс від кліку. Повторіть або спробуйте дротовий вихід, якщо затримка змінюється."
          }
        }
      }
    },
    "sync.approximateResult": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate rhythm and overall scores using personal synchronization. Consistent personal timing bias may be included in the compensation."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизні оцінки ритму та загального результату з персональною синхронізацією. Компенсація може включати вашу сталу звичку грати раніше чи пізніше."
          }
        }
      }
    },
    "sync.tolerance %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rhythm tolerance: ±%lld ms"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допуск ритму: ±%lld мс"
          }
        }
      }
    },
    "assessment.rhythmReason.approximate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

    "coach.recordAndAnalyze": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record & analyze"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записати й проаналізувати"
          }
        }
      }
    },
    "coach.actionExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record & analyze saves this take and asks your selected AI agent for feedback after practice. Up to 2 minutes; one take, no repeat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Записати й проаналізувати» зберігає цю спробу та запитує поради в обраного AI-агента після практики. До 2 хвилин; одна спроба, без повторення."
          }
        }
      }
    },
    "coach.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent interprets local audio measurements and lesson context. Your CLI may send this data to its cloud provider. AI advice is separate from your score; it does not prove fingering or exact latency."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент інтерпретує локальні вимірювання звуку та контекст уроку. Ваш CLI може надсилати ці дані своєму хмарному провайдеру. AI-поради відокремлені від оцінки; вони не доводять аплікатуру чи точну затримку."
          }
        }
      }
    },
    "coach.setup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Codex or Claude Code and sign in from Terminal first. Supported locations: Homebrew, /usr/local/bin, ~/.local/bin, and the Codex app CLI. Analysis runs automatically through a separate helper; no API key is stored in this app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку встановіть Codex або Claude Code та увійдіть через Terminal. Підтримуються Homebrew, /usr/local/bin, ~/.local/bin і CLI додатка Codex. Аналіз запускається автоматично через окремий процес; цей додаток не зберігає API-ключів."
          }
        }
      }
    },
    "coach.retention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is off for ordinary practice. AI takes, context and advice stay on this Mac until deleted in the result. WAV channel 1 contains guitar; channel 2 contains the scheduled metronome reference, not the sound actually heard in headphones."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звичайна практика не записується. AI-записи, контекст і поради зберігаються на цьому Mac до видалення в результаті. Канал 1 WAV містить гітару, канал 2 — запланований метроном, а не звук, фактично почутий у навушниках."
          }
        }
      }
    },

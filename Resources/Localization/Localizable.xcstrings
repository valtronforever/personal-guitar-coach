    "audio.error.dataLoss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio data was lost or invalid. This capture cannot be graded. Check the device and buffer size, then restart."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіодані втрачено або пошкоджено. Це захоплення не можна оцінювати. Перевір пристрій і розмір буфера та запусти знову."
          }
        }
      }
    },
    "audio.error.stalled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The input stopped delivering audio frames. Check the connection and start again."

      }
    },
    "sync.timeline.legend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines: clicks. ·1–·4: listen only; 1–16: measured beats. ● detected · △ other pitch · ? uncertain · ○ no detected event. Values: ms from the nearest click; + means later. This visual association is not a success score."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лінії — кліки. ·1–·4 — лише слухати; 1–16 — вимірювані удари. ● зареєстровано · △ інша висота · ? невизначено · ○ немає події. Значення — мс від найближчого кліку; + означає пізніше. Візуальне зіставлення не є оцінкою успішності."
          }
        }
      }
    },

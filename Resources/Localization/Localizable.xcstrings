      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes all saved practice attempts, scores, and recommendations from this Mac, including unreadable attempt files. Your instrument settings and lessons remain. This cannot be undone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить з цього Mac усі збережені спроби, оцінки та рекомендації, включно з нечитабельними файлами спроб. Налаштування інструмента й уроки залишаться. Скасувати видалення неможливо."
          }
        }
      }

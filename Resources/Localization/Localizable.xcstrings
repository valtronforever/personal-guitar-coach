    "audio.error.routeChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio stopped because the selected device or its format changed. Check the route and start again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо зупинено через зміну вибраного пристрою або його формату. Перевір маршрут і запусти знову."
          }
        }
      }
    },
    "audio.error.dataLoss": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio data was lost or invalid. This capture cannot be graded. Check the device and buffer size, then restart."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіодані втрачено або пошкоджено. Це захоплення не можна оцінювати. Перевір пристрій і розмір буфера та запусти знову."
          }
        }
      }
    },
    "audio.error.stalled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The input stopped delivering audio frames. Check the connection and start again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід перестав надсилати аудіокадри. Перевір підключення та запусти знову."
          }
        }
      }
    },
    "audio.error.suspended": {
      "extractionState": "manual",
      "localizations": {

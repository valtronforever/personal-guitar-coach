        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося запустити аудіопристрій. Перевір підключення та налаштування."
          }
        }
      }
    },
    "audio.error.device": {
      "extractionState": "manual",
      "localizations": {

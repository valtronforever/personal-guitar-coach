    "sync.timeline.retained": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelines remain after completion, failure or cancellation, and when reopening this window in this app session. Take a screenshot for diagnosis. Measuring again replaces only that setting’s timeline."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шкали залишаються після завершення, помилки або скасування та при повторному відкритті цього вікна в поточній сесії додатка. Можна зробити скриншот для діагностики. Нове вимірювання замінює лише шкалу відповідного налаштування."
          }
        }
      }
    },

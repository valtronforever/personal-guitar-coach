      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the input and play clean single notes for the signal check. There is not enough reliable evidence to assess playing."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте вхід і зіграйте чисті окремі ноти для перевірки сигналу. Надійних даних для оцінки гри недостатньо."
          }
        }
      }
    },
    "feedback.interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve the audio interruption before a new attempt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усуньте причину переривання аудіо перед новою спробою."
          }
        }
      }
    },
    "feedback.restart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a fresh attempt with a new count-in. The partial attempt is not graded."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть нову спробу з відліком. Незавершена спроба не оцінюється."
          }
        }
      }
    },
    "feedback.calibration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check route calibration to enable rhythm and overall scores. Pitch feedback remains available."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте калібрування маршруту для оцінки ритму й загального бала. Аналіз висоти доступний."
          }
        }
      }
    },
    "feedback.early": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several attacks were earlier than the timing tolerance. Repeat with the metronome."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька атак були ранішими за допустиму межу. Повторіть із метрономом."
          }
        }
      }
    },
    "feedback.late": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several attacks were later than the timing tolerance. Repeat with the metronome."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька атак були пізнішими за допустиму межу. Повторіть із метрономом."
          }
        }
      }
    },
    "feedback.missed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several expected attacks were missing while the input remained reliable. Repeat the fragment."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька очікуваних атак були відсутні за надійного входу. Повторіть фрагмент."
          }
        }
      }
    },
    "feedback.pitch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same target pitch repeatedly differed by at least 50 cents. Review its expected note and repeat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Та сама цільова висота неодноразово відрізнялася щонайменше на 50 центів. Перегляньте очікувану ноту та повторіть."
          }
        }
      }
    },
    "feedback.tuning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least three target pitches have a repeated deviation in the same direction. Check with the tuner; these measurements do not identify the cause."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щонайменше три цільові висоти мають повторюване відхилення в одному напрямку. Перевірте тюнером; ці виміри не визначають причину."
          }
        }
      }
    },
    "feedback.rests": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional attacks occurred during rests. Repeat the fragment and leave the written rests between attacks."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час пауз зафіксовано додаткові атаки. Повторіть фрагмент, залишаючи записані паузи між атаками."
          }
        }
      }
    },
    "feedback.repeatFragment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat this fragment to build a comparable record of practice. One attempt does not establish mastery."
          }
        },

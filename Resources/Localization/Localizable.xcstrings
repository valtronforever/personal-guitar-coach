    "audio.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app has exclusive access to this device. Release it there, then retry."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший додаток має виключний доступ до пристрою. Звільни його там і повтори спробу."
          }
        }
      }

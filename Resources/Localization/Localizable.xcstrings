    "sync.instrument.unset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrument timing has not been calibrated. Output alignment can remain at 0 ms."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймінг інструмента ще не відкалібровано. Зсув виходу може залишатися 0 мс."
          }
        }
      }
    },
    "sync.instrument.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remeasure or reapply a manual value for this instrument and audio connection."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторіть вимірювання або застосуйте ручне значення для цього інструменту й аудіопідключення."
          }
        }
      }
    },
    "sync.instrument.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose and tune one open string. After Start, let it ring for the signal check. Listen to four clicks, then play one note on each of the next sixteen clicks, letting it ring for about half a second before muting. The saved output alignment is already applied to this timeline; 0 ms works without a separate output measurement."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть і налаштуйте одну відкриту струну. Після початку дайте їй звучати для перевірки сигналу. Прослухайте чотири кліки, потім грайте одну ноту на кожен із наступних шістнадцяти, даючи їй звучати приблизно пів секунди перед глушінням. Збережений зсув виходу вже застосовано до цієї шкали; значення 0 мс працює без окремого вимірювання виходу."
          }
        }
      }
    },
    "sync.instrument.measure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure instrument"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виміряти інструмент"
          }
        }
      }
    },
    "sync.instrument.measured": {
      "extractionState": "manual",

    "calibration.manualExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 0 to 1000 ms. A positive value compensates for recorded attacks arriving late. Manual offsets and hardware estimates are not measured evidence and do not enable rhythm scores."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть від 0 до 1000 мс. Додатне значення компенсує запізнення записаних атак. Ручне зміщення й апаратна оцінка не є виміряними доказами та не відкривають оцінку ритму."
          }
        }
      }
    },
    "calibration.saveManual": {

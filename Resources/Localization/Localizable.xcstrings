    "history.clearTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all practice history?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити всю історію практики?"

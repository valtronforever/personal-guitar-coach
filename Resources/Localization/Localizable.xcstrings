    "tab.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read left to right. Fractions show duration as part of a whole note; dashed lines group beats. Shift-click selects a range. Use arrow keys, then Space or Return."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читай зліва направо. Дроби показують тривалість як частину цілої ноти; пунктир групує долі. Shift-клік вибирає діапазон. Використовуй стрілки, потім пробіл або Return."
          }
        }
      }
    },

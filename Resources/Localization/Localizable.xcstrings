      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured with loopback"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виміряне через loopback"
          }
        }
      }
    },
    "calibration.offset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Residual offset (ms)"
          }
        },

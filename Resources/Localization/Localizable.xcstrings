    "staff.tie.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start of one sustained note. Follow the tie without another attack. Select to highlight the whole note."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Початок однієї довгої ноти. Продовжуйте по лізі без нової атаки. Виберіть, щоб позначити всю ноту."
          }
        }
      }
    },
    "staff.tie.middle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuation of the same note, tied on both sides. Do not attack again. Select to highlight the whole note."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовження тієї самої ноти, ліги з обох боків. Не атакуйте знову. Виберіть, щоб позначити всю ноту."
          }
        }
      }
    },
    "staff.tie.end": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End of the same sustained note. Do not attack again here. Select to highlight the whole note."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закінчення тієї самої довгої ноти. Не атакуйте тут знову. Виберіть, щоб позначити всю ноту."
          }
        }
      }
    },
    "staff.dottedNote %@ %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotted note: written %@, sounding %@, duration %@ of a whole note."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нота з крапкою: записана %@, звучить %@, тривалість %@ цілої ноти."
          }
        }
      }
    },

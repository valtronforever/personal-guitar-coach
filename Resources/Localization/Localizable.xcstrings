            "state": "translated",
            "value": "Пауза з крапкою, тривалість %@ цілої ноти."
          }
        }
      }
    },
    "practice.rangeExpandedForSustain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The range includes complete sustained notes and rests, so none is cut at a barline."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діапазон охоплює довгі ноти й паузи повністю, щоб не обрізати їх на тактовій рисці."
          }
        }
      }
    },
    "assessment.sustain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustain"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримання"
          }
        }
      }
    },
    "assessment.sustainExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustain measures the share of a marked note held at the target pitch, allowing for the attack and release edges. It contributes 20% of the overall score when requested by the exercise; it does not measure an exact release time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримання показує частку позначеної ноти з потрібною висотою, з допуском на початок і закінчення. Якщо вправа його перевіряє, це 20% загальної оцінки; точний момент заглушення не оцінюється."
          }
        }
      }
    },
    "assessment.sustainUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough reliable evidence to score sustain for this attempt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо надійних вимірювань, щоб оцінити утримання в цій спробі."
          }
        }
      }
    },
    "practice.sustainRequirement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marked sustained notes are assessed for stable target pitch through their duration. They must last at least 0.5 seconds at the chosen tempo. Play ties without a second attack."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У позначених довгих нотах перевіряється утримання потрібної висоти. За обраного темпу вони мають тривати щонайменше 0,5 секунди. Ноти з лігою грайте без повторної атаки."
          }
        }
      }
    },
    "result.sustainHeld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target pitch held through %lld%% of the measured interval."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібна висота звучала протягом %lld%% виміряного інтервалу."
          }
        }
      }
    },
    "result.sustainSilent %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silence occupied %lld%% of the measured interval."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тиша зайняла %lld%% виміряного інтервалу."
          }
        }
      }
    },
    "feedback.sustain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the target pitch through the written duration. Listen for early silence or a changed note, then repeat the marked fragment."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте потрібну висоту протягом записаної тривалості. Послухайте, чи немає передчасної тиші або зміни ноти, і повторіть позначений фрагмент."
          }
        }
      }
    },
    "result.annotation.sustain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note ended early or changed pitch"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нота обірвалася рано або змінила висоту"
          }
        }
      }
    }
  },
  "version": "1.0"
}

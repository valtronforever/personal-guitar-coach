    },
    "audio.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio setup"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування аудіо"
          }
        }
      }
    },
    "audio.introduction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the guitar input and one channel. Input stays separate from the click output."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибери вхід гітари та один канал. Вхід аналізується окремо від виходу метронома."
          }
        }
      }
    },
    "audio.input": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input device"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрій входу"
          }
        }
      }
    },

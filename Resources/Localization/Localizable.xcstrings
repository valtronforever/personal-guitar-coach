    "common.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "audio.clickExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test click: 120 BPM at low volume. No software monitoring or audio recording."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестовий метроном: 120 BPM на невеликій гучності. Без програмного моніторингу та запису аудіо."
          }
        }
      }
    },
    "audio.error.system": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio device could not start. Check its connection and configuration."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося запустити аудіопристрій. Перевір підключення та налаштування."
          }
        }
      }
    },
    "audio.error.device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected audio device is unavailable. Refresh the list."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний аудіопристрій недоступний. Онови список."
          }
        }
      }
    },
    "audio.error.channel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected input channel is not available."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний вхідний канал недоступний."
          }
        }
      }
    },
    "audio.error.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This audio format is not supported."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей формат аудіо не підтримується."
          }
        }
      }
    },
    "audio.error.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access for Guitar Coach in System Settings to use audio input."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь доступ до мікрофона для Guitar Coach у Системних параметрах, щоб використовувати аудіовхід."
          }
        }
      }
    },
    "audio.error.memory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio buffers could not be allocated. Close other apps and try again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося виділити аудіобуфери. Закрий інші програми та спробуй ще раз."
          }
        }
      }
    },
    "audio.waitingInput": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for audio permission or the input device…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуємо дозвіл на аудіовхід або відповідь пристрою…"
          }
        }
      }
    },
    "audio.waitingOutput": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the output device…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікуємо відповідь вихідного пристрою…"
          }
        }
      }
    }
  },
  "version": "1.0"
}

          "stringUnit": {
            "state": "translated",
            "value": "Match your guitar. The fretboard and lesson fingerings use this limit. Changing it stops playback and an active practice attempt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкажи кількість ладів на своїй гітарі. Гриф та аплікатури уроків враховують цю межу. Зміна зупиняє відтворення й активну спробу практики."
          }
        }
      }
    },

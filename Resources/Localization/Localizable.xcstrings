      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying device settings stops the current capture and may affect other apps using this device. Input capture currently accepts 44.1 and 48 kHz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосування налаштувань пристрою зупиняє захоплення й може вплинути на інші додатки, що його використовують. Захоплення входу наразі приймає 44,1 і 48 кГц."
          }
        }
      }
    },
    "audio.inputGain": {
      "extractionState": "manual",

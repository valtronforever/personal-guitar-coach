    "playback.seekExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a position while stopped or paused, then play with a new count-in. Later loops use the full bar range."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери позицію під час зупинки або паузи, потім почни з нового відліку. Наступні повтори охоплюють увесь вибраний діапазон тактів."
          }
        }
      }
    },
    "playback.optionsExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause or stop to change these options. They apply to the next playback segment. Set example volume to zero to hear only the metronome."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Призупини або зупини відтворення, щоб змінити параметри. Вони діятимуть із наступного запуску. Гучність прикладу 0 залишає лише метроном."
          }
        }
      }
    },
    "playback.audioInUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the other audio activity before playing an example."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупини інший аудіорежим перед прослуховуванням прикладу."
          }
        }
      }
    },
    "playback.chooseOutput": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an output and channel in Audio setup to listen. No microphone permission is needed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери вихід і канал у налаштуваннях аудіо. Для прослуховування дозвіл на мікрофон не потрібен."
          }
        }
      }
    },
    "playback.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This playback range or audio format is unsupported. Choose a longer range or another output format."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей діапазон відтворення або аудіоформат не підтримується. Обери довший діапазон або інший формат виходу."
          }
        }
      }
    },
    "audio.previewActive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An example is playing. Stop playback before testing input."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворюється приклад. Зупини його перед перевіркою входу."
          }
        }
      }
    },
    "calibration.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing synchronization"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізація таймінгу"
          }
        }
      }
    },
    "calibration.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Align recorded attacks with the metronome. Tuning and pitch practice remain available without measured calibration."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Узгодьте записані атаки з метрономом. Тюнер і практика висоти доступні без виміряного калібрування."
          }
        }
      }
    },
    "calibration.hardwareExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware latency includes the device and selected stream. Buffer and safety values identify the route; they are not subtracted a second time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апаратна затримка включає пристрій та вибраний потік. Буфер і запас кадрів визначають маршрут; їх не віднімаємо вдруге."
          }
        }
      }
    },
    "calibration.separateDevices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate devices have separate clocks. Rhythm scoring needs fresh clock evidence and a calibration run at least as long as the attempt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Різні пристрої мають окремі годинники. Для оцінки ритму потрібні актуальні дані годинників і калібрування тривалістю не меншою за спробу."
          }
        }
      }
    },
    "calibration.chooseRoute": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an available input and output in Audio Setup first."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку виберіть доступні вхід і вихід у налаштуваннях аудіо."
          }
        }
      }
    },
    "calibration.profile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current route profile"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль поточного маршруту"
          }
        }
      }
    },
    "calibration.method.none": {
      "extractionState": "manual",
      "localizations": {

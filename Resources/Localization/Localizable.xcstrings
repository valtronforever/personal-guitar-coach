    },
    "sync.output.value": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output alignment, ms"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зсув виходу, мс"
          }
        }
      }
    },
    "sync.output.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional alignment of the visual cursor to the sound. Reported system latency is handled automatically. Keyboard/mouse tapping also includes your timing and input-device delay, so this is approximate, not a hardware measurement."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додаткове вирівнювання візуального курсора зі звуком. Відома системна затримка враховується автоматично. Натискання клавіатурою чи мишкою включають ваш таймінг і затримку пристрою введення, тому це приблизне вирівнювання, а не вимірювання обладнання."
          }
        }
      }
    },
    "sync.output.measure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure output with taps"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виміряти вихід натисканнями"
          }
        }
      }
    },
    "sync.output.reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset output to 0 ms"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скинути вихід до 0 мс"
          }
        }
      }
    },
    "sync.output.measured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured output alignment, ms"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виміряний зсув виходу, мс"
          }
        }
      }
    },
    "sync.output.apply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply output alignment"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосувати зсув виходу"
          }
        }
      }
    },
    "sync.output.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen to four clicks, then tap Space, Return or this button on each of the next sixteen audible clicks. Follow the sound, not the moving line. Hold neither key; repeated key-down events are ignored."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прослухайте чотири кліки, потім натискайте пробіл, Return або цю кнопку на кожен із наступних шістнадцяти чутних кліків. Орієнтуйтеся на звук, а не рухому лінію. Не утримуйте клавішу; автоматичні повтори ігноруються."
          }
        }
      }
    },
    "sync.output.count %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected taps: %lld / 16 measured clicks."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зареєстровані натискання: %lld / 16 вимірюваних кліків."
          }
        }
      }
    },
    "sync.tap.button": {
      "extractionState": "manual",
      "localizations": {

    "practice.repeatExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each repeat is a separate attempt with a new count-in after the final note has been analyzed. Pausing resumes from the current bar with a new attempt. Changing tempo or bars interrupts the current attempt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен повтор — окрема спроба з новим відліком після аналізу останньої ноти. Після паузи нова спроба починається з поточного такту. Зміна темпу або тактів перериває поточну спробу."
          }
        }
      }
    },
    "practice.pitchOnlyExplanation": {
      "extractionState": "manual",

{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal Guitar Coach"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Персональний гітарний тренер"
          }
        }
      }
    },
    "welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn a little. Play it. Hear your progress."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трохи теорії. Трохи гри. Відчуй свій прогрес."
          }
        }
      }
    },
    "welcome.acoustic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acoustic guitar is also supported through a microphone or pickup."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Акустична гітара також підтримується через мікрофон або звукознімач."
          }
        }
      }
    },
    "source.electric": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Electric guitar · Audio interface"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Електрогітара · Аудіоінтерфейс"
          }
        }
      }
    },
    "source.microphone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acoustic guitar · Microphone"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Акустична гітара · Мікрофон"
          }
        }
      }
    },
    "source.pickup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

    "staff.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guitar notes are written one octave above their sound. Key signatures change spelling only. This prototype shows single notes and rests; bends, slides, legato, tuplets and tempo changes are not represented or assessed."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ноти гітари записано на октаву вище їхнього звучання. Ключові знаки змінюють лише запис. Прототип показує окремі ноти й паузи; підтягування, слайди, легато, тріолі та зміни темпу тут не відображаються й не оцінюються."
          }
        }
      }
    },

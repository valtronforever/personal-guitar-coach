    "sync.manual.totalHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the total output delay from the device specification. The app subtracts the delay already reported by the output. The total must be at least that reported delay so the correction stays nonnegative."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть повну затримку виходу зі специфікації пристрою. Програма відніме затримку, яку вже повідомляє вихід. Повне значення має бути не меншим за повідомлену затримку, щоб поправка лишалася невід’ємною."
          }
        }
      }
    },
    "sync.manual.additionalHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a nonnegative correction in addition to the delay already reported by the output. A positive value moves the cursor later."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть невід’ємну поправку до затримки, яку вже повідомляє вихід. Додатне значення зміщує курсор пізніше."
          }
        }
      }
    },
    "sync.manual.instrumentHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the remaining guitar offset relative to the current output setting. Use the timeline values you consider representative. The original events stay visible. Rhythm scores use this value and are labeled Manual setting; accuracy has not been measured. Reapply after restarting or changing the audio connection."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть залишковий зсув гітари відносно поточного налаштування виходу. Орієнтуйтеся на значення шкали, які вважаєте показовими. Початкові події залишаються видимими. Оцінка ритму використовуватиме це значення з позначкою «Ручне налаштування»; точність не виміряно. Застосуйте повторно після перезапуску чи зміни аудіопідключення."
          }
        }
      }
    },
    "sync.manual.range": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed range: 0–1000 ms. Total output + instrument compensation must not exceed 1000 ms. A decimal dot or comma is accepted."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволений діапазон: 0–1000 мс. Сума поправок виходу й інструменту не має перевищувати 1000 мс. Дозволено десяткову крапку або кому."
          }
        }
      }
    },
    "sync.manual.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a delay from 0 to 1000 ms. Negative corrections are not allowed; combined compensation must not exceed 1000 ms."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть затримку від 0 до 1000 мс. Від’ємні поправки заборонені; сумарна компенсація не має перевищувати 1000 мс."
          }
        }
      }
    },
    "sync.manual.value": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delay"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Затримка"
          }
        }
      }
    },
    "sync.manual.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: 120 or 25.5"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наприклад: 120 або 25,5"
          }
        }
      }
    },
    "sync.manual.unit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ms"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "мс"
          }
        }
      }
    },
    "sync.manual.apply": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосувати"
          }
        }
      }
    },
    "sync.nonnegative.measurement": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The measured negative offset remains on the timeline for diagnosis and cannot be applied. Repeat the measurement or enter a value from 0 to 1000 ms."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виміряне від’ємне зміщення залишається на шкалі для діагностики й не може бути застосоване. Повторіть вимірювання або введіть значення від 0 до 1000 мс."
          }
        }
      }
    },
    "sync.nonnegative.savedOutput": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved negative output setting is inactive. Using 0 ms; enter a nonnegative value or reset this setting."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережене від’ємне налаштування виходу вимкнено. Використовується 0 мс; введіть невід’ємне значення або скиньте це налаштування."
          }
        }
      }
    },
    "sync.nonnegative.savedInstrument": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved setting contains a negative correction and is not used for scoring. Apply a nonnegative value or repeat the measurement. Past practice results are unchanged."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це збережене налаштування містить від’ємну поправку й не використовується для оцінювання. Застосуйте невід’ємне значення або повторіть вимірювання. Минулі результати практики не змінено."
          }
        }
      }
    },

    "lesson.adaptationUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This lesson cannot preserve its notes and supported fingering within the selected tuning and fret count. Choose another instrument profile in Settings."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти ноти й підтримувану аплікатуру уроку в межах вибраного строю та кількості ладів. Вибери інший профіль інструмента в налаштуваннях."
          }
        }
      }
    },
    "tuning.lessonAdaptation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lessons adapt automatically. Scales and arpeggios transpose with string 1; positions on other strings adjust to keep the intervals. Open-string, fret and rhythm lessons follow the selected strings directly."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уроки адаптуються автоматично. Гами й арпеджіо транспонуються разом зі струною 1; позиції на інших струнах змінюються для збереження інтервалів. Уроки відкритих струн, ладів і ритму безпосередньо слідують за вибраними струнами."
          }
        }
      }
    },
    "tuning.preset.b-standard": {
